  "notes": [
    "\u26a1 <b>Auto Ramp \u00b7 After Effects</b> \u2014 fixed a crash when adjusting the ramp keyframes after running Auto Ramp. Undo now steps back one stage at a time, like the individual buttons."
  ],
  "releases": [
    {
      "version": "1.8.0",
      "notes": [
